# Example test configuration
# Copy this file to .env and configure for local testing

# AWS Configuration
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1

# Optional: Use specific AWS profile
# export AWS_PROFILE=my-test-profile

# Optional: Use specific AWS credentials
# export AWS_ACCESS_KEY_ID=your-access-key
# export AWS_SECRET_ACCESS_KEY=your-secret-key

# Terraform Configuration
export TF_IN_AUTOMATION=true

# Optional: Enable Terraform debug logging
# export TF_LOG=DEBUG
# export TF_LOG_PATH=terraform.log

# Test Configuration
export GO_TEST_TIMEOUT=60m
export GO_TEST_PARALLEL=4

# Example usage:
# source test.env
# make test
